# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ledger_of_loss
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ledger_of_loss

# MongoDB Configuration
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=adminpassword
MONGODB_DB=ledger_of_loss
MONGODB_URI=mongodb://admin:adminpassword@localhost:27017/ledger_of_loss?authSource=admin

# Security & Sessions (JWT Secret for 'jose')
JWT_SECRET=super-secret-jwt-key-minimum-32-chars-long!

# Seed User & Admin Passwords (used during npm run db:seed)
SEED_ADMIN_PASSWORD=AdminPass123!
SEED_USER_PASSWORD=UserPass123!
